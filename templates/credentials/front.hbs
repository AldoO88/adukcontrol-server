<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8"/>
<style>
  @page { size: Letter; margin: 0; }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  
  body {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    background: #fff;
  }
  
  .page {
    width: 8.5in;
    height: 11in;
    position: relative;
    overflow: hidden;
    background: #fff;
  }
  
  /* ========================= */
  /* LADO A — FRENTE            */
  /* ========================= */
  .front {
    width: 100%;
    height: 100%;
    position: relative;
    padding: 0.4in 0.5in;
    display: flex;
    flex-direction: column;
  }
  
  /* Elementos decorativos */
  .deco-top-left {
    position: absolute;
    top: 0;
    left: 0;
    width: 2.5in;
    height: 3in;
    background: linear-gradient(135deg, #8B1A2B 0%, #8B1A2B 50%, transparent 50%);
    opacity: 0.15;
  }
  
  .deco-top-right {
    position: absolute;
    top: 0;
    right: 0;
    width: 1.5in;
    height: 2in;
    background: linear-gradient(225deg, #8B1A2B 0%, #8B1A2B 50%, transparent 50%);
    opacity: 0.1;
  }
  
  .deco-bottom-left {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 3in;
    height: 2.5in;
    background: linear-gradient(45deg, #8B1A2B 0%, #8B1A2B 50%, transparent 50%);
    opacity: 0.1;
  }
  
  /* Header con logos */
  .header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 0.15in;
    position: relative;
    z-index: 1;
  }
  
  .logo-dget {
    width: 0.8in;
    height: 0.8in;
    object-fit: contain;
  }
  
  .logo-ihe {
    width: 1.8in;
    height: 0.5in;
    object-fit: contain;
  }
  
  /* Nombre de la escuela */
  .school-title {
    text-align: center;
    margin-bottom: 0.2in;
    position: relative;
    z-index: 1;
  }
  
  .school-title h1 {
    font-size: 14px;
    font-weight: 800;
    color: #0f172a;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    line-height: 1.2;
  }
  
  .school-title h2 {
    font-size: 12px;
    font-weight: 600;
    color: #8B1A2B;
    font-style: italic;
    margin-top: 2px;
  }
  
  /* Contenido principal */
  .content {
    display: flex;
    gap: 0.3in;
    flex: 1;
    position: relative;
    z-index: 1;
  }
  
  /* Foto del alumno */
  .photo-section {
    flex-shrink: 0;
  }
  
  .student-photo {
    width: 1.6in;
    height: 1.8in;
    border-radius: 8px;
    object-fit: cover;
    border: 2px solid #e2e8f0;
    background: #f1f5f9;
  }
  
  .photo-placeholder {
    width: 1.6in;
    height: 1.8in;
    border-radius: 8px;
    background: #f1f5f9;
    border: 2px solid #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 48px;
    color: #94a3b8;
  }
  
  /* Datos del alumno */
  .student-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  
  .student-name {
    font-size: 20px;
    font-weight: 800;
    color: #0f172a;
    text-transform: uppercase;
    line-height: 1.1;
  }
  
  .control-number-label {
    font-size: 9px;
    font-weight: 700;
    color: #475569;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  
  .control-number-badge {
    background: #8B1A2B;
    color: #fff;
    padding: 6px 16px;
    border-radius: 6px;
    font-size: 16px;
    font-weight: 800;
    text-align: center;
    display: inline-block;
    letter-spacing: 1px;
  }
  
  .blood-type-badge {
    background: #1e293b;
    color: #fff;
    padding: 8px 20px;
    border-radius: 6px;
    font-size: 18px;
    font-weight: 800;
    text-align: center;
    display: inline-block;
  }
  
  .grade-badge {
    background: #8B1A2B;
    color: #fff;
    padding: 8px 24px;
    border-radius: 6px;
    font-size: 22px;
    font-weight: 800;
    text-align: center;
    display: inline-block;
  }
  
  .shift-text {
    font-size: 11px;
    font-weight: 700;
    color: #475569;
    text-transform: uppercase;
    letter-spacing: 2px;
  }
  
  /* Sección inferior */
  .footer-section {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    position: relative;
    z-index: 1;
  }
  
  .cycle-section {
    flex: 1;
  }
  
  .cycle-label {
    font-size: 9px;
    font-weight: 700;
    color: #475569;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 4px;
  }
  
  .cycle-badge {
    background: #8B1A2B;
    color: #fff;
    padding: 6px 16px;
    border-radius: 6px;
    font-size: 16px;
    font-weight: 800;
    display: inline-block;
  }
  
  .emergency-section {
    text-align: right;
  }
  
  .emergency-text {
    font-size: 8px;
    color: #475569;
    margin-bottom: 4px;
  }
  
  .emergency-phone {
    display: flex;
    align-items: center;
    gap: 6px;
    justify-content: flex-end;
  }
  
  .phone-icon {
    width: 20px;
    height: 20px;
    background: #8B1A2B;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 10px;
    font-weight: bold;
  }
  
  .phone-number {
    background: #8B1A2B;
    color: #fff;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 14px;
    font-weight: 800;
  }
</style>
</head>
<body>
<div class="page front">
  <!-- Elementos decorativos -->
  <div class="deco-top-left"></div>
  <div class="deco-top-right"></div>
  <div class="deco-bottom-left"></div>
  
  <!-- Header con logos -->
  <div class="header">
    <img src="{{school.dgetLogoUrl}}" class="logo-dget" alt="DGET"/>
    <img src="{{school.iheLogoUrl}}" class="logo-ihe" alt="IHE"/>
  </div>
  
  <!-- Nombre de la escuela -->
  <div class="school-title">
    <h1>{{school.name}}</h1>
    {{#if school.honoraryName}}
    <h2>"{{school.honoraryName}}"</h2>
    {{/if}}
  </div>
  
  <!-- Contenido principal -->
  <div class="content">
    <!-- Foto del alumno -->
    <div class="photo-section">
      {{#if student.photoUrl}}
      <img src="{{student.photoUrl}}" class="student-photo" alt="Foto del alumno"/>
      {{else}}
      <div class="photo-placeholder">?</div>
      {{/if}}
    </div>
    
    <!-- Datos del alumno -->
    <div class="student-info">
      <div class="student-name">{{student.last_name}} {{student.first_name}}</div>
      
      <div>
        <div class="control-number-label">No. CONTROL</div>
        <div class="control-number-badge">{{student.controlNumber}}</div>
      </div>
      
      {{#if student.blood_type}}
      <div class="blood-type-badge">{{student.blood_type}}</div>
      {{/if}}
      
      <div class="grade-badge">{{formatGrade group.grade group.section}}</div>
      
      <div class="shift-text">TURNO {{formatShift group.shift}}</div>
    </div>
  </div>
  
  <!-- Sección inferior -->
  <div class="footer-section">
    <div class="cycle-section">
      <div class="cycle-label">CICLO ESCOLAR</div>
      <div class="cycle-badge">{{schoolYear.name}}</div>
    </div>
    
    <div class="emergency-section">
      <div class="emergency-text">En caso de emergencia<br/>llamar a:</div>
      <div class="emergency-phone">
        <div class="phone-icon">☎</div>
        <div class="phone-number">{{school.phoneNumber}}</div>
      </div>
    </div>
  </div>
</div>
</body>
</html>
