<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8"/>
<style>
  @page { size: Letter; margin: 0; }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  
  body {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    background: #fff;
  }
  
  .page {
    width: 8.5in;
    height: 11in;
    position: relative;
    overflow: hidden;
    background: #fff;
  }
  
  .back {
    width: 100%;
    height: 100%;
    position: relative;
    padding: 0.5in 0.6in;
    display: flex;
    flex-direction: column;
  }
  
  /* Header */
  .back-header {
    text-align: center;
    margin-bottom: 0.3in;
    position: relative;
    z-index: 1;
  }
  
  .back-header h1 {
    font-size: 16px;
    font-weight: 800;
    color: #0f172a;
    text-transform: uppercase;
  }
  
  .back-header h2 {
    font-size: 14px;
    font-weight: 600;
    color: #8B1A2B;
    font-style: italic;
    margin-top: 2px;
  }
  
  .back-header .cct {
    font-size: 11px;
    color: #475569;
    margin-top: 4px;
    letter-spacing: 1px;
  }
  
  .back-header .address {
    font-size: 9px;
    color: #64748b;
    margin-top: 6px;
    line-height: 1.4;
  }
  
  /* Línea decorativa */
  .divider {
    height: 2px;
    background: linear-gradient(90deg, transparent, #8B1A2B, transparent);
    margin: 0.15in 0;
  }
  
  /* Indicaciones */
  .indications {
    flex: 1;
    position: relative;
    z-index: 1;
  }
  
  .indications h3 {
    font-size: 16px;
    font-weight: 800;
    color: #8B1A2B;
    text-transform: uppercase;
    margin-bottom: 0.15in;
    letter-spacing: 1px;
  }
  
  .indication-item {
    display: flex;
    gap: 10px;
    margin-bottom: 10px;
    align-items: flex-start;
  }
  
  .indication-number {
    width: 22px;
    height: 22px;
    background: #8B1A2B;
    color: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 700;
    flex-shrink: 0;
  }
  
  .indication-text {
    font-size: 10px;
    color: #334155;
    line-height: 1.5;
    flex: 1;
  }
  
  /* Watermark */
  .watermark {
    position: absolute;
    bottom: 1.5in;
    right: 0.5in;
    width: 2.5in;
    height: 2.5in;
    opacity: 0.06;
    z-index: 0;
  }
  
  .watermark img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  
  /* Valores */
  .values-section {
    text-align: center;
    margin-top: auto;
    padding-top: 0.15in;
    position: relative;
    z-index: 1;
  }
  
  .values-line {
    height: 1px;
    background: #8B1A2B;
    margin-bottom: 8px;
  }
  
  .values-text {
    font-size: 12px;
    font-weight: 700;
    color: #0f172a;
    letter-spacing: 3px;
    text-transform: uppercase;
  }
  
  .values-text .dot {
    color: #8B1A2B;
    margin: 0 8px;
  }
  
  /* Director */
  .director-section {
    text-align: center;
    margin-top: 0.2in;
    position: relative;
    z-index: 1;
  }
  
  .director-name {
    font-size: 11px;
    font-weight: 700;
    color: #0f172a;
  }
  
  .director-title {
    font-size: 9px;
    color: #64748b;
  }
  
  /* Branding */
  .branding {
    text-align: center;
    margin-top: 0.15in;
    position: relative;
    z-index: 1;
  }
  
  .branding-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }
  
  .branding-icon {
    width: 20px;
    height: 20px;
    background: #0f172a;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 10px;
  }
  
  .branding-name {
    font-size: 14px;
    font-weight: 800;
    color: #0f172a;
  }
  
  .branding-tagline {
    font-size: 7px;
    color: #64748b;
    margin-top: 2px;
  }
  
  /* Ciudad */
  .city-section {
    text-align: center;
    margin-top: 0.15in;
    padding: 8px;
    background: #8B1A2B;
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    position: relative;
    z-index: 1;
  }
</style>
</head>
<body>
<div class="page back">
  <!-- Header -->
  <div class="back-header">
    <h1>{{school.name}}</h1>
    {{#if school.honoraryName}}
    <h2>"{{school.honoraryName}}"</h2>
    {{/if}}
    <div class="cct">C.C.T. {{school.cct}}</div>
    {{#if school.address}}
    <div class="address">{{school.address}}</div>
    {{/if}}
  </div>
  
  <div class="divider"></div>
  
  <!-- Indicaciones -->
  <div class="indications">
    <h3>INDICACIONES</h3>
    {{#each school.indications}}
    <div class="indication-item">
      <div class="indication-number">{{@index_plus_one}}</div>
      <div class="indication-text">{{this}}</div>
    </div>
    {{/each}}
  </div>
  
  <!-- Watermark -->
  {{#if school.watermarkUrl}}
  <div class="watermark">
    <img src="{{school.watermarkUrl}}" alt=""/>
  </div>
  {{/if}}
  
  <!-- Valores -->
  <div class="values-section">
    <div class="values-line"></div>
    <div class="values-text">
      DISCIPLINA<span class="dot">●</span>RESPETO<span class="dot">●</span>EXCELENCIA
    </div>
  </div>
  
  <!-- Director -->
  {{#if school.directorName}}
  <div class="director-section">
    <div class="director-name">{{school.directorName}}</div>
    <div class="director-title">Director</div>
  </div>
  {{/if}}
  
  <!-- Branding -->
  <div class="branding">
    <div class="branding-logo">
      <div class="branding-icon">🎓</div>
      <div class="branding-name">EdukControl</div>
    </div>
    <div class="branding-tagline">Tecnologia para una mejor escuela</div>
  </div>
  
  <!-- Ciudad -->
  {{#if school.city}}
  <div class="city-section">{{school.city}}</div>
  {{/if}}
</div>
</body>
</html>
